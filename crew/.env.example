# Copy to crew/.env and fill in. crew/.env is git-ignored.

# Required — Anthropic API key (Claude powers every agent)
ANTHROPIC_API_KEY=sk-ant-...

# Required for the WebSearcher agent — Brave Search API key
# Free tier (2,000 queries/mo): https://brave.com/search/api
BRAVE_SEARCH_API_KEY=BSA...

# Optional overrides (defaults shown)
AGENT_MODEL=claude-opus-4-8
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
SCOPE_THRESHOLD=0.28
